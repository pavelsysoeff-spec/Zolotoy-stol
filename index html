<!DOCTYPE html>
<html lang="ru">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover">
<meta name="theme-color" content="#0a1712">
<meta name="mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-capable" content="yes">
<meta name="apple-mobile-web-app-status-bar-style" content="black-translucent">
<meta name="apple-mobile-web-app-title" content="Золотой Стол">
<link rel="manifest" href="manifest.webmanifest">
<link rel="icon" type="image/png" sizes="192x192" href="icon-192.png">
<link rel="apple-touch-icon" href="icon-192.png">
<title>Золотой Стол — Мини-казино</title>
<style>
  :root{
    --bg:#0a1712;
    --felt:#0f2a1e;
    --felt-light:#123524;
    --panel:#0d1f17;
    --gold:#d4af37;
    --gold-light:#f2cf7e;
    --gold-dim:#8a6f2a;
    --cream:#ece2c8;
    --cream-dim:#b7ac93;
    --red:#b8342a;
    --red-light:#d9534a;
    --black-chip:#1b1b1b;
    --green-zero:#1e6b45;
    --shadow: 0 10px 30px rgba(0,0,0,.5);
    --serif: Georgia, 'Times New Roman', serif;
    --sans: 'Segoe UI', system-ui, -apple-system, Helvetica, Arial, sans-serif;
    box-sizing:border-box;
    padding-top: env(safe-area-inset-top, 0px);
    padding-bottom: env(safe-area-inset-bottom, 0px);
  }
  *{box-sizing:border-box;}
  html{ scroll-padding-top: env(safe-area-inset-top, 0px); height:100%; }
  html,body{
    margin:0; padding:0; height:100%;
    background:
      radial-gradient(ellipse at 50% -10%, #1d4a3488 0%, transparent 55%),
      radial-gradient(ellipse at 85% 110%, #3a2a0a55 0%, transparent 50%),
      radial-gradient(ellipse at 8% 105%, #0e2a4a44 0%, transparent 50%),
      repeating-conic-gradient(from 45deg, rgba(212,175,55,.05) 0deg 45deg, transparent 45deg 90deg),
      var(--bg);
    background-attachment: fixed;
    color:var(--cream);
    font-family:var(--sans);
    -webkit-tap-highlight-color: transparent;
    overflow-x:hidden;
  }
  #app{ min-height:100%; display:flex; flex-direction:column; }

  /* ---------- HEADER ---------- */
  header{
    display:flex; align-items:center; justify-content:space-between;
    padding:14px 18px;
    padding-top: calc(14px + env(safe-area-inset-top, 0px));
    background:linear-gradient(180deg, #0d1e16, #0a1712 90%);
    border-bottom:1px solid var(--gold-dim);
    position:sticky; top:0; z-index:20;
    gap:10px;
  }
  .brand{ display:flex; align-items:center; gap:10px; min-width:0; }
  .brand-mark{
    width:34px;height:34px; border-radius:50%; flex:none;
    background: radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold) 55%, var(--gold-dim) 100%);
    box-shadow: 0 0 10px rgba(212,175,55,.5), inset 0 0 3px rgba(0,0,0,.4);
    display:flex; align-items:center; justify-content:center;
    font-size:16px; color:#2a1e05; font-weight:bold;
  }
  .brand-name{
    font-family:var(--serif); font-size:19px; letter-spacing:.5px; color:var(--gold-light);
    line-height:1; white-space:nowrap;
  }
  .brand-sub{ font-size:10px; color:var(--cream-dim); letter-spacing:1.5px; white-space:nowrap; }
  .header-right{ display:flex; align-items:center; gap:8px; flex:none; }
  .balance{
    display:flex; align-items:center; gap:8px;
    background:var(--panel); border:1px solid var(--gold-dim);
    padding:7px 14px; border-radius:20px;
  }
  .balance .chip-ic{
    width:16px;height:16px;border-radius:50%;
    background:repeating-conic-gradient(var(--gold) 0deg 45deg, var(--red) 45deg 90deg);
    border:1.5px solid var(--gold-light);
  }
  .balance span{ font-family:var(--serif); font-size:16px; font-weight:bold; color:var(--gold-light); }

  .lang-switch{
    display:flex; background:var(--panel); border:1px solid var(--gold-dim);
    border-radius:20px; overflow:hidden; flex:none;
  }
  .lang-btn{
    border:none; background:transparent; color:var(--cream-dim);
    font-size:12px; font-family:var(--sans); font-weight:600;
    padding:7px 10px; cursor:pointer; letter-spacing:.5px;
  }
  .lang-btn.active{ background:var(--gold); color:#2a1e05; }

  /* ---------- LOBBY ---------- */
  main{ flex:1; width:100%; max-width:640px; margin:0 auto; padding:18px; }
  .lobby-title{
    font-family:var(--serif); font-size:22px; color:var(--cream); text-align:center;
    margin:6px 0 4px;
  }
  .lobby-sub{ text-align:center; color:var(--cream-dim); font-size:13px; margin-bottom:22px; }

  .tables{ display:flex; flex-direction:column; gap:16px; }
  .table-card{
    background:
      radial-gradient(ellipse at 50% -30%, rgba(212,175,55,.10), transparent 60%),
      linear-gradient(160deg, var(--felt-light), var(--felt) 70%);
    border:1px solid var(--gold-dim);
    border-radius:14px;
    padding:18px;
    display:flex; align-items:center; gap:16px;
    cursor:pointer;
    box-shadow: var(--shadow);
    transition: transform .15s ease, border-color .15s ease;
  }
  .table-card:active{ transform: scale(.98); }
  .table-card:hover{ border-color:var(--gold); }
  .table-ic{ font-size:34px; width:56px; text-align:center; filter:drop-shadow(0 2px 4px rgba(0,0,0,.5)); }
  .table-info h3{ margin:0 0 4px; font-family:var(--serif); font-size:18px; color:var(--gold-light); }
  .table-info p{ margin:0; font-size:12.5px; color:var(--cream-dim); line-height:1.4; }
  .table-go{ margin-left:auto; color:var(--gold); font-size:20px; }

  /* ---------- GAME SCREENS shared ---------- */
  .game-screen{ display:none; }
  .game-screen.active{ display:block; animation:fadein .25s ease; }
  @keyframes fadein{ from{opacity:0; transform:translateY(6px);} to{opacity:1; transform:translateY(0);} }

  .topbar{ display:flex; align-items:center; gap:10px; margin-bottom:16px; }
  .back-btn{
    background:var(--panel); border:1px solid var(--gold-dim); color:var(--gold-light);
    border-radius:10px; padding:8px 12px; font-size:14px; cursor:pointer;
  }
  .game-title{ font-family:var(--serif); font-size:19px; color:var(--gold-light); }

  .felt-panel{
    background:
      radial-gradient(ellipse at 50% 0%, rgba(255,255,255,.05), transparent 60%),
      linear-gradient(160deg, var(--felt-light), var(--felt) 80%);
    border:1px solid var(--gold-dim);
    border-radius:16px;
    padding:20px 16px;
    box-shadow: var(--shadow);
  }

  .bet-row{ display:flex; align-items:center; justify-content:center; gap:10px; margin:16px 0; flex-wrap:wrap; }
  .chip-btn{
    border:none; border-radius:50%; width:52px; height:52px;
    font-family:var(--serif); font-weight:bold; font-size:13px;
    color:var(--cream); cursor:pointer;
    display:flex; align-items:center; justify-content:center;
    box-shadow: inset 0 0 0 2px rgba(255,255,255,.15), 0 3px 6px rgba(0,0,0,.5);
    transition: transform .1s ease;
  }
  .chip-btn:active{ transform:scale(.92); }
  .chip-10{ background:radial-gradient(circle at 35% 30%, #4c8c5c, #245933); }
  .chip-50{ background:radial-gradient(circle at 35% 30%, #4b6fb0, #223b6e); }
  .chip-100{ background:radial-gradient(circle at 35% 30%, var(--red-light), var(--red)); }
  .chip-500{ background:radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold-dim)); color:#2a1e05; }

  .current-bet{ text-align:center; font-size:13px; color:var(--cream-dim); margin-bottom:4px; }
  .current-bet b{ color:var(--gold-light); font-size:17px; font-family:var(--serif); }

  .primary-btn{
    display:block; width:100%; margin-top:14px;
    background:linear-gradient(180deg, var(--gold-light), var(--gold) 80%);
    color:#2a1e05; border:none; border-radius:10px;
    padding:13px; font-family:var(--serif); font-size:16px; font-weight:bold;
    cursor:pointer; box-shadow:0 4px 10px rgba(212,175,55,.3);
  }
  .primary-btn:disabled{ opacity:.45; cursor:not-allowed; box-shadow:none; }
  .secondary-btn{
    background:var(--panel); border:1px solid var(--gold-dim); color:var(--cream);
    border-radius:10px; padding:12px; font-size:14px; cursor:pointer; flex:1;
  }
  .secondary-btn:disabled{ opacity:.4; cursor:not-allowed; }
  .btn-row{ display:flex; gap:10px; margin-top:12px; }

  .msg{
    text-align:center; min-height:22px; font-size:14px; color:var(--gold-light);
    margin-top:10px; font-family:var(--serif);
  }

  /* ---------- SLOTS ---------- */
  .reels{
    display:flex; gap:8px; justify-content:center;
    background:var(--panel); border-radius:12px; padding:14px;
    border:2px solid var(--gold-dim);
  }
  .reel{
    width:72px; height:72px; background:#0a1712;
    border-radius:8px; overflow:hidden;
    display:flex; align-items:center; justify-content:center;
    font-size:38px; border:1px solid var(--gold-dim);
  }
  .reel.spin{ animation:spinblur .08s linear infinite; }
  @keyframes spinblur{ 0%{filter:blur(0px);} 50%{filter:blur(3px);} 100%{filter:blur(0px);} }
  .paytable{ margin-top:14px; font-size:11.5px; color:var(--cream-dim); text-align:center; line-height:1.7; }

  /* ---------- ROULETTE ---------- */
  .wheel-wrap{ display:flex; justify-content:center; margin-bottom:6px; position:relative; }
  .wheel-pointer{
    position:absolute; top:-4px; left:50%; transform:translateX(-50%);
    width:0; height:0; border-left:9px solid transparent; border-right:9px solid transparent;
    border-top:16px solid var(--gold-light); z-index:5; filter:drop-shadow(0 2px 2px rgba(0,0,0,.5));
  }
  .wheel{
    width:180px; height:180px; border-radius:50%;
    border:5px solid var(--gold);
    box-shadow: 0 0 0 3px #0a1712, inset 0 0 20px rgba(0,0,0,.6), var(--shadow);
    transition: transform 3.2s cubic-bezier(.15,.85,.15,1);
    position:relative;
  }
  .wheel-center{
    position:absolute; top:50%; left:50%; width:26px; height:26px;
    background:radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold-dim));
    border-radius:50%; transform:translate(-50%,-50%); box-shadow:0 2px 4px rgba(0,0,0,.5);
  }
  .result-number{
    width:46px; height:46px; border-radius:50%; margin:10px auto 2px;
    display:flex; align-items:center; justify-content:center;
    font-family:var(--serif); font-size:20px; font-weight:bold; color:var(--cream);
    border:2px solid var(--gold-light);
  }
  .bet-grid{
    display:grid; grid-template-columns:repeat(7,1fr); gap:4px; margin-top:16px;
  }
  .num-cell{
    aspect-ratio:1; display:flex; align-items:center; justify-content:center;
    font-size:12px; border-radius:5px; cursor:pointer; color:var(--cream);
    border:1px solid rgba(255,255,255,.1); position:relative;
  }
  .num-cell.red{ background:var(--red); }
  .num-cell.black{ background:var(--black-chip); }
  .num-cell.zero{ background:var(--green-zero); grid-column:span 7; aspect-ratio:auto; height:30px; }
  .num-cell.selected{ outline:2px solid var(--gold-light); outline-offset:1px; }
  .outside-bets{ display:flex; gap:6px; margin-top:8px; flex-wrap:wrap; }
  .outside-bet{
    flex:1; min-width:70px; text-align:center; padding:9px 4px; border-radius:8px;
    font-size:12px; cursor:pointer; border:1px solid var(--gold-dim); background:var(--panel);
  }
  .outside-bet.selected{ outline:2px solid var(--gold-light); background:#1a3a28; }

  /* ---------- BLACKJACK ---------- */
  .dealer-area, .player-area{ margin-bottom:10px; }
  .hand-label{ font-size:12px; color:var(--cream-dim); margin-bottom:6px; display:flex; justify-content:space-between; }
  .hand-label b{ color:var(--gold-light); }
  .cards{ display:flex; gap:-10px; min-height:78px; }
  .card{
    width:50px; height:72px; background:var(--cream); border-radius:6px;
    display:flex; flex-direction:column; align-items:center; justify-content:center;
    font-family:var(--serif); font-size:18px; font-weight:bold;
    margin-left:-16px; box-shadow:0 3px 6px rgba(0,0,0,.5); border:1px solid #0002;
  }
  .card:first-child{ margin-left:0; }
  .card.red{ color:var(--red); }
  .card.black{ color:#1b1b1b; }
  .card.back{
    background:repeating-linear-gradient(45deg, #1a3a28, #1a3a28 4px, #123524 4px, #123524 8px);
    border:1px solid var(--gold-dim);
  }
  .divider{ height:1px; background:var(--gold-dim); opacity:.4; margin:14px 0; }

  /* ---------- CLICKER ---------- */
  #coinBtn{
    width:150px; height:150px; border-radius:50%; border:4px solid var(--gold);
    background: radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold) 55%, var(--gold-dim) 100%);
    box-shadow: 0 0 20px rgba(212,175,55,.4), inset 0 -6px 10px rgba(0,0,0,.25);
    cursor:pointer; font-size:64px; line-height:1;
    display:inline-flex; align-items:center; justify-content:center;
    transition: transform .08s ease;
    user-select:none; -webkit-user-select:none;
    position:relative; touch-action:manipulation;
  }
  #coinBtn:active{ transform:scale(.93); }
  #coinBtn.pop{ animation:coinpop .15s ease; }
  @keyframes coinpop{ 0%{transform:scale(1);} 40%{transform:scale(1.12);} 100%{transform:scale(1);} }
  .fly-text{
    position:absolute; left:50%; top:-8px; transform:translateX(-50%);
    font-family:var(--serif); font-weight:bold; font-size:18px; color:var(--gold-light);
    pointer-events:none; animation:flyup .8s ease forwards;
    text-shadow:0 2px 4px rgba(0,0,0,.6); white-space:nowrap;
  }
  @keyframes flyup{ from{opacity:1; transform:translate(-50%,0);} to{opacity:0; transform:translate(-50%,-60px);} }

  .xpbar{ height:8px; background:#0a1712; border:1px solid var(--gold-dim); border-radius:6px; overflow:hidden; margin:6px 0 2px; }
  .xpbar > div{ height:100%; background:linear-gradient(90deg,var(--gold-dim),var(--gold-light)); width:0%; transition:width .3s; }
  .combo-tag{
    position:absolute; top:-12px; right:-26px;
    font-family:var(--serif); font-weight:bold; font-size:14px; color:var(--gold-light);
    text-shadow:0 2px 4px rgba(0,0,0,.6); white-space:nowrap; pointer-events:none;
  }
  .skin-row{ display:flex; gap:8px; justify-content:center; margin-top:12px; flex-wrap:wrap; }
  .skin-btn{
    width:42px; height:42px; border-radius:50%; font-size:20px; line-height:1;
    background:var(--panel); border:2px solid var(--gold-dim); cursor:pointer;
    display:flex; align-items:center; justify-content:center; padding:0;
  }
  .skin-btn.active{ border-color:var(--gold-light); box-shadow:0 0 8px rgba(212,175,55,.5); }
  .skin-btn:disabled{ opacity:.3; cursor:not-allowed; }
  .section-title{ font-family:var(--serif); color:var(--gold-light); font-size:15px; margin:18px 0 2px; text-align:left; }
  .shop-item{
    display:flex; align-items:center; gap:10px; background:var(--panel);
    border:1px solid var(--gold-dim); border-radius:10px; padding:9px 10px; margin-top:8px; text-align:left;
  }
  .shop-item .ic{ font-size:24px; width:32px; text-align:center; flex:none; }
  .shop-item .info{ flex:1; min-width:0; }
  .shop-item .info b{ color:var(--gold-light); font-size:13px; display:block; font-family:var(--serif); }
  .shop-item .info span{ font-size:11px; color:var(--cream-dim); }
  .buy-btn{
    background:linear-gradient(180deg,var(--gold-light),var(--gold) 80%); color:#2a1e05;
    border:none; border-radius:8px; padding:7px 12px; font-size:12px; font-weight:bold;
    cursor:pointer; flex:none; font-family:var(--serif); white-space:nowrap;
  }
  .buy-btn:disabled{ opacity:.4; cursor:not-allowed; }
  .ach-grid{ display:grid; grid-template-columns:repeat(auto-fill,minmax(42px,1fr)); gap:8px; margin-top:10px; }
  .ach-badge{
    aspect-ratio:1; border-radius:10px; background:var(--panel); border:1px solid var(--gold-dim);
    display:flex; align-items:center; justify-content:center; font-size:19px; opacity:.35;
  }
  .ach-badge.unlocked{ opacity:1; border-color:var(--gold); box-shadow:0 0 8px rgba(212,175,55,.35); }
  .ach-toast{
    position:fixed; bottom:20px; left:50%; transform:translateX(-50%);
    background:var(--panel); border:1px solid var(--gold); border-radius:10px;
    padding:10px 18px; font-size:13px; color:var(--gold-light); z-index:50;
    box-shadow:var(--shadow); font-family:var(--serif); max-width:90%; text-align:center;
  }

  /* ---------- CARD GAMES (durak/poker/uno) ---------- */
  .card.sm{ width:40px; height:56px; font-size:14px; margin-left:-18px; }
  .cards.wrap{ flex-wrap:wrap; row-gap:8px; }
  .dk-table{ display:flex; justify-content:center; gap:22px; min-height:62px; margin:12px 0; align-items:center; }
  .bet-custom{ display:flex; gap:8px; justify-content:center; align-items:center; margin:10px 0 2px; }
  .bet-custom input{
    width:120px; background:var(--panel); border:1px solid var(--gold-dim);
    color:var(--gold-light); border-radius:10px; padding:10px; font-size:14px;
    font-family:var(--serif); text-align:center;
  }
  .bet-custom input:focus{ outline:none; border-color:var(--gold); }
  .chip-btn.mini{ width:auto; height:auto; border-radius:10px; padding:10px 14px; font-size:13px; }
  .chip-max{ background:radial-gradient(circle at 35% 30%, var(--gold-light), var(--gold-dim)) !important; color:#2a1e05; }
  .uno-card{
    width:44px; height:64px; border-radius:8px; flex:none;
    display:flex; align-items:center; justify-content:center;
    font-weight:bold; font-size:16px; color:#fff;
    border:2px solid rgba(255,255,255,.55); margin-left:-12px;
    box-shadow:0 3px 6px rgba(0,0,0,.5); cursor:pointer; position:relative;
  }
  .uno-card:first-child{ margin-left:0; }
  .uno-card.red{ background:linear-gradient(160deg,#d9534a,#b8342a); }
  .uno-card.yellow{ background:linear-gradient(160deg,#e8b93a,#c8931f); color:#3a2a00; }
  .uno-card.green{ background:linear-gradient(160deg,#2ea866,#1e6b45); }
  .uno-card.blue{ background:linear-gradient(160deg,#2e86c1,#1a5276); }
  .uno-card.wild{ background:linear-gradient(135deg,#b8342a 0 25%,#c8931f 25% 50%,#1e6b45 50% 75%,#1a5276 75%); }
  .uno-card.playable{ outline:2px solid var(--gold-light); outline-offset:1px; transform:translateY(-4px); }
  .uno-card.static{ cursor:default; }
  .uno-pile{
    width:60px; height:86px; background:repeating-linear-gradient(45deg,#1a3a28,#1a3a28 4px,#123524 4px,#123524 8px);
    border:1px solid var(--gold-dim); border-radius:10px; color:var(--gold-light);
    font-size:24px; cursor:pointer; font-family:var(--serif); line-height:1.2;
  }
  .color-dot{ width:18px; height:18px; border-radius:50%; display:inline-block; border:2px solid rgba(255,255,255,.4); vertical-align:middle; }
  .color-dot.red{ background:#c0392b; } .color-dot.yellow{ background:#d4a017; }
  .color-dot.green{ background:#1e8449; } .color-dot.blue{ background:#1a5276; }
  .color-btn{ width:36px; height:36px; border-radius:50%; border:2px solid rgba(255,255,255,.5); cursor:pointer; }
  .color-btn.red{ background:#c0392b; } .color-btn.yellow{ background:#d4a017; }
  .color-btn.green{ background:#1e8449; } .color-btn.blue{ background:#1a5276; }

  footer{ text-align:center; padding:14px; color:var(--cream-dim); font-size:11px; opacity:.6; }
</style>
</head>
<body>
<div id="app">

  <header>
    <div class="brand">
      <div class="brand-mark">♣</div>
      <div style="min-width:0;">
        <div class="brand-name" data-i18n="brandName">Золотой Стол</div>
        <div class="brand-sub" data-i18n="brandSub">МИНИ-КАЗИНО</div>
      </div>
    </div>
    <div class="header-right">
      <div class="lang-switch">
        <button class="lang-btn" data-lang="ru">RU</button>
        <button class="lang-btn" data-lang="en">EN</button>
      </div>
      <div class="balance"><div class="chip-ic"></div><span id="balanceDisplay">1000</span></div>
    </div>
  </header>

  <main>

    <!-- LOBBY -->
    <div id="lobby" class="game-screen active">
      <div class="lobby-title" data-i18n="lobbyTitle">Выберите стол</div>
      <div class="lobby-sub" data-i18n="lobbySub">Три игры, одна касса. Удачи за столом.</div>
      <div class="tables">
        <div class="table-card" data-target="screen-slots">
          <div class="table-ic">🎰</div>
          <div class="table-info">
            <h3 data-i18n="slotsName">Слоты</h3>
            <p data-i18n="slotsDesc">Три барабана, шесть символов. Соберите комбинацию — сорвите куш.</p>
          </div>
          <div class="table-go">→</div>
        </div>
        <div class="table-card" data-target="screen-roulette">
          <div class="table-ic">🎡</div>
          <div class="table-info">
            <h3 data-i18n="rouletteName">Рулетка</h3>
            <p data-i18n="rouletteDesc">Европейское колесо. Ставьте на число, цвет или чёт-нечет.</p>
          </div>
          <div class="table-go">→</div>
        </div>
        <div class="table-card" data-target="screen-blackjack">
