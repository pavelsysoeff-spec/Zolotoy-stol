  (function(){
    var symbols = ["🍒","🍋","🔔","⭐","💎","7️⃣"];
    var weights  = [30, 25, 18, 14, 9, 4]; // lower weight = rarer
    var payoutMultipliers = {"7️⃣":20, "💎":15, "⭐":10, "🔔":8, "🍋":5, "🍒":3};
    var bet = 10;
    var spinning = false;

    document.querySelectorAll("[data-slotbet]").forEach(function(btn){
      btn.addEventListener("click", function(){
        if(spinning) return;
        bet = parseInt(btn.dataset.slotbet, 10);
        document.getElementById("slotsBetDisplay").textContent = bet;
      });
    });
    setupCustomBet("slots", function(v){ bet = v; document.getElementById("slotsBetDisplay").textContent = v; });

    function weightedSymbol(){
      var total = weights.reduce(function(a,b){return a+b;},0);
      var r = Math.random() * total;
      for(var i=0;i<symbols.length;i++){
        if(r < weights[i]) return symbols[i];
        r -= weights[i];
      }
      return symbols[0];
    }

    var spinBtn = document.getElementById("spinBtn");
    var msgEl = document.getElementById("slotsMsg");
    var reels = [document.getElementById("reel0"), document.getElementById("reel1"), document.getElementById("reel2")];

    spinBtn.addEventListener("click", function(){
      if(spinning) return;
      if(balance < bet){ setMsg("slots", msgEl, "insufficient"); return; }
      spinning = true;
      spinBtn.disabled = true;
      setBalance(balance - bet);
      setMsg("slots", msgEl, "slotsSpinning");

      reels.forEach(function(r){ r.classList.add("spin"); });

      var results = [weightedSymbol(), weightedSymbol(), weightedSymbol()];
      var delays = [900, 1300, 1700];

      reels.forEach(function(reel, i){
        var flickerTimer = setInterval(function(){
          reel.textContent = symbols[Math.floor(Math.random()*symbols.length)];
        }, 70);
        setTimeout(function(){
          clearInterval(flickerTimer);
          reel.classList.remove("spin");
          reel.textContent = results[i];
          if(i === reels.length-1){ evaluateSpin(results); }
        }, delays[i]);
      });
    });

    function evaluateSpin(results){
      var win = 0;
      if(results[0]===results[1] && results[1]===results[2]){
        win = bet * payoutMultipliers[results[0]];
        setMsg("slots", msgEl, "slotsJackpot", {sym: results[0], win: win});
      } else if(results[0]===results[1] || results[1]===results[2] || results[0]===results[2]){
        win = Math.round(bet * 1.5);
        setMsg("slots", msgEl, "slotsPair", {win: win});
      } else {
        setMsg("slots", msgEl, "slotsLose");
      }
      if(win > 0){ setBalance(balance + win); celebrate(win >= bet * 3); }
      spinning = false;
      spinBtn.disabled = false;
    }
  })();

  /* =========================================================
     ROULETTE
