      dealerHand.forEach(function(c, i){
        if(hideDealerHole && i === 1){
          var back = document.createElement("div");
          back.className = "card back";
          dealerCardsEl.appendChild(back);
        } else {
          dealerCardsEl.appendChild(renderCard(c));
        }
      });
      playerScoreEl.textContent = handScore(playerHand);
      dealerScoreEl.textContent = hideDealerHole ? "?" : handScore(dealerHand);
    }

    function startRound(){
      if(balance < bet){ setMsg("blackjack", msgEl, "insufficient"); return; }
      setBalance(balance - bet);
      deck = freshDeck();
      playerHand = [deck.pop(), deck.pop()];
      dealerHand = [deck.pop(), deck.pop()];
      inRound = true;
      canDouble = balance >= bet;
      betPanel.style.display = "none";
      actionPanel.style.display = "block";
      document.getElementById("doubleBtn").disabled = !canDouble;
      renderHands(true);
      setMsg("blackjack", msgEl, "bjYourTurn");

      if(handScore(playerHand) === 21){
        finishRound();
      }
    }

    document.getElementById("dealBtn").addEventListener("click", startRound);

    document.getElementById("hitBtn").addEventListener("click", function(){
      if(!inRound) return;
      playerHand.push(deck.pop());
      canDouble = false;
      document.getElementById("doubleBtn").disabled = true;
      renderHands(true);
      if(handScore(playerHand) > 21){
        setMsg("blackjack", msgEl, "bjBust");
        finishRound(true);
      }
    });

    document.getElementById("standBtn").addEventListener("click", function(){
      if(!inRound) return;
      finishRound();
    });

    document.getElementById("doubleBtn").addEventListener("click", function(){
      if(!inRound || !canDouble) return;
      setBalance(balance - bet);
      bet = bet * 2;
      betDisplay.textContent = bet;
      playerHand.push(deck.pop());
      renderHands(true);
      if(handScore(playerHand) > 21){
        setMsg("blackjack", msgEl, "bjBustDouble");
        finishRound(true);
      } else {
        finishRound();
      }
    });

    function finishRound(playerBusted){
      inRound = false;
      var playerTotal = handScore(playerHand);

      if(!playerBusted){
        while(handScore(dealerHand) < 17){
          dealerHand.push(deck.pop());
        }
      }
      renderHands(false);
      var dealerTotal = handScore(dealerHand);
      var playerBJ = playerTotal === 21 && playerHand.length === 2;
      var dealerBJ = dealerTotal === 21 && dealerHand.length === 2;

      var win = 0, key = "", params = null;
      if(playerBusted){
        key = "bjBust";
      } else if(playerBJ && !dealerBJ){
        win = Math.round(bet * 2.5);
        key = "bjBlackjack"; params = {win: win};
      } else if(dealerBJ && !playerBJ){
        key = "bjDealerBJ";
      } else if(dealerTotal > 21){
        win = bet * 2;
        key = "bjDealerBust"; params = {win: win};
      } else if(playerTotal > dealerTotal){
        win = bet * 2;
        key = "bjWin"; params = {win: win};
      } else if(playerTotal === dealerTotal){
        win = bet;
        key = "bjPush";
      } else {
        key = "bjDealerWins";
      }

      if(win > 0) setBalance(balance + win);
      if(win > bet) celebrate(playerBJ);
      setMsg("blackjack", msgEl, key, params);

      actionPanel.style.display = "none";
      betPanel.style.display = "block";
      bet = 10;
      betDisplay.textContent = bet;
    }
  })();



  /* =========================================================
