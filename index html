  (function(){
    var wheelOrder = [0,32,15,19,4,21,2,25,17,34,6,27,13,36,11,30,8,23,10,5,24,16,33,1,20,14,31,9,22,18,29,7,28,12,35,3,26];
    var redNumbers = [1,3,5,7,9,12,14,16,18,19,21,23,25,27,30,32,34,36];
    var bet = 10;
    var selection = null; // {type:'number', value:7} or {type:'outside', value:'red'}
    var spinning = false;

    var betDisplay = document.getElementById("rouletteBetDisplay");
    var selDisplay = document.getElementById("rouletteSelDisplay");
    var msgEl = document.getElementById("rouletteMsg");
    var spinBtnR = document.getElementById("spinWheelBtn");
    var wheel = document.getElementById("wheel");
    var resultEl = document.getElementById("resultNumber");

    document.querySelectorAll("[data-roubet]").forEach(function(btn){
      btn.addEventListener("click", function(){
        if(spinning) return;
        bet = parseInt(btn.dataset.roubet, 10);
        betDisplay.textContent = bet;
      });
    });
    setupCustomBet("rou", function(v){ bet = v; document.getElementById("rouletteBetDisplay").textContent = v; });

    // build number grid 1-36 in 3 rows like classic layout, plus 0
    var grid = document.getElementById("numberGrid");
    var zeroCell = document.createElement("div");
    zeroCell.className = "num-cell zero";
    zeroCell.textContent = "0";
    zeroCell.dataset.num = "0";
    grid.appendChild(zeroCell);
    for(var n=1; n<=36; n++){
      var cell = document.createElement("div");
      cell.className = "num-cell " + (redNumbers.indexOf(n) !== -1 ? "red" : "black");
      cell.textContent = n;
      cell.dataset.num = n;
      grid.appendChild(cell);
    }

    function clearSelectionUI(){
      document.querySelectorAll(".num-cell.selected, .outside-bet.selected").forEach(function(el){
        el.classList.remove("selected");
      });
    }

    function setSelDisplay(key, n){
      selDisplay.dataset.selKey = key;
      if(n !== undefined){ selDisplay.dataset.selN = n; selDisplay.textContent = t(key, {n:n}); }
      else { delete selDisplay.dataset.selN; selDisplay.textContent = t(key); }
    }

    grid.addEventListener("click", function(e){
      if(spinning) return;
      var cell = e.target.closest(".num-cell");
      if(!cell) return;
      clearSelectionUI();
      cell.classList.add("selected");
      selection = { type:"number", value: parseInt(cell.dataset.num,10) };
      setSelDisplay("selNumber", cell.dataset.num);
      spinBtnR.disabled = false;
    });

    document.querySelectorAll(".outside-bet").forEach(function(el){
      el.addEventListener("click", function(){
        if(spinning) return;
        clearSelectionUI();
        el.classList.add("selected");
        selection = { type:"outside", value: el.dataset.outside };
        var keyMap = {red:"selRed", black:"selBlack", odd:"selOdd", even:"selEven"};
        setSelDisplay(keyMap[el.dataset.outside]);
        spinBtnR.disabled = false;
      });
    });

    var currentRotation = 0;

    spinBtnR.addEventListener("click", function(){
      if(spinning || !selection) return;
      if(balance < bet){ setMsg("roulette", msgEl, "insufficient"); return; }
      spinning = true;
      spinBtnR.disabled = true;
      setBalance(balance - bet);
      setMsg("roulette", msgEl, "rouletteSpinning");
      resultEl.style.visibility = "hidden";

      var winningIndex = Math.floor(Math.random() * wheelOrder.length);
      var winningNumber = wheelOrder[winningIndex];
      var degreesPerSlot = 360 / wheelOrder.length;
      var targetSlotAngle = winningIndex * degreesPerSlot;
      var extraSpins = 6 * 360;
      currentRotation += extraSpins + (360 - (currentRotation % 360)) + targetSlotAngle;

      wheel.style.background = "conic-gradient(" + buildWheelGradient() + ")";
      wheel.style.transform = "rotate(" + currentRotation + "deg)";

      setTimeout(function(){
        resultEl.style.visibility = "visible";
        resultEl.textContent = winningNumber;
        resultEl.style.background = winningNumber === 0 ? "var(--green-zero)" : (redNumbers.indexOf(winningNumber)!==-1 ? "var(--red)" : "var(--black-chip)");
        evaluateRoulette(winningNumber);
      }, 3300);
    });

    function buildWheelGradient(){
      var parts = [];
      var step = 360 / wheelOrder.length;
      wheelOrder.forEach(function(num, i){
        var color = num===0 ? "#1e6b45" : (redNumbers.indexOf(num)!==-1 ? "#b8342a" : "#1b1b1b");
        parts.push(color + " " + (i*step) + "deg " + ((i+1)*step) + "deg");
      });
      return parts.join(", ");
    }

    function evaluateRoulette(num){
      var win = 0;
      if(selection.type === "number"){
        if(selection.value === num) win = bet * 36;
      } else {
        var isRed = redNumbers.indexOf(num) !== -1;
        var isOdd = num !== 0 && num % 2 === 1;
        if(selection.value === "red" && isRed) win = bet * 2;
        else if(selection.value === "black" && !isRed && num!==0) win = bet * 2;
        else if(selection.value === "odd" && isOdd) win = bet * 2;
        else if(selection.value === "even" && num!==0 && !isOdd) win = bet * 2;
      }
      if(win > 0){
        setBalance(balance + win);
        celebrate(selection.type === "number");
        setMsg("roulette", msgEl, "rouletteWin", {n:num, win:win});
      } else {
        setMsg("roulette", msgEl, "rouletteLose", {n:num});
      }
      spinning = false;
      spinBtnR.disabled = false;
    }
  })();

