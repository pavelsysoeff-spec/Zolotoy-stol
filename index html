    setupCustomBet("dk", function(v){ bet = v; document.getElementById("dkBetDisplay").textContent = v; });

    function makeCard(r, s){ return {r:r, s:s, c:(s==="♥"||s==="♦")?"red":"black"}; }
    function newDeck(){
      var d = [];
      suits.forEach(function(s){ ranks.forEach(function(r){ d.push(makeCard(r,s)); }); });
      for(var i=d.length-1;i>0;i--){ var j=Math.floor(Math.random()*(i+1)); var tmp=d[i]; d[i]=d[j]; d[j]=tmp; }
      return d;
    }
    function val(c){ return ranks.indexOf(c.r); }
    function beats(def, atk){
      if(def.s === atk.s && val(def) > val(atk)) return true;
      if(def.s === trumpSuit && atk.s !== trumpSuit) return true;
      return false;
    }
    function sortHand(h){
      h.sort(function(a,b){
        var at = (a.s===trumpSuit)?1:0, bt = (b.s===trumpSuit)?1:0;
        if(at !== bt) return at-bt;
        if(a.s !== b.s) return suits.indexOf(a.s)-suits.indexOf(b.s);
        return val(a)-val(b);
      });
    }
    function cardEl(c, small){
      var d = document.createElement("div");
      d.className = "card" + (small ? " sm" : "") + " " + c.c;
      d.innerHTML = c.r + "<span style='font-size:" + (small ? 14 : 20) + "px'>" + c.s + "</span>";
      d.style.marginLeft = "0";
      return d;
    }
    function render(){
      aiHandEl.innerHTML = "";
      ai.forEach(function(){
        var b = document.createElement("div");
        b.className = "card sm back";
        aiHandEl.appendChild(b);
      });
      aiCountEl.textContent = ai.length;
      tableEl.innerHTML = "";
      if(tableAtk) tableEl.appendChild(cardEl(tableAtk, true));
      playerHandEl.innerHTML = "";
      player.forEach(function(c, idx){
        var el = cardEl(c, true);
        el.style.cursor = "pointer";
        el.addEventListener("click", function(){ onPlayerCard(idx); });
        playerHandEl.appendChild(el);
      });
      trumpEl.textContent = t("durakTrump") + ": " + trumpSuit + " · " + deck.length;
      takeWrap.style.display = (gameOn && attacker === "a" && tableAtk) ? "flex" : "none";
    }

    dealBtn.addEventListener("click", function(){
      if(gameOn) return;
      if(balance < bet){ msgEl.innerHTML = t("insufficient"); return; }
      setBalance(balance - bet);
      deck = newDeck();
      trumpSuit = deck[deck.length-1].s;
      player = deck.splice(0, 6); ai = deck.splice(0, 6);
      attacker = "p"; tableAtk = null; gameOn = true; busy = false;
      sortHand(player); sortHand(ai);
      msgEl.innerHTML = t("durakAttack");
      render();
    });

    takeBtn.addEventListener("click", function(){
      if(!gameOn || attacker !== "a" || !tableAtk) return;
      player.push(tableAtk); tableAtk = null;
      sortHand(player);
      refill();
      if(checkEnd()) return;
      msgEl.innerHTML = t("durakAiAttack");
      render();
      setTimeout(aiAttack, 700);
    });

    function onPlayerCard(idx){
      if(!gameOn || busy) return;
      var c = player[idx];
      if(attacker === "p"){
        player.splice(idx, 1);
        tableAtk = c;
        var def = aiDefend(c);
        busy = true;
        render();
        if(def){
          setTimeout(function(){
            ai.splice(ai.indexOf(def), 1);
            tableAtk = null;
            swap(); refill(); busy = false;
            if(checkEnd()) return;
            msgEl.innerHTML = t("durakAiAttack");
            render();
            setTimeout(aiAttack, 700);
          }, 600);
        } else {
          msgEl.innerHTML = t("durakAiTakes");
          setTimeout(function(){
            ai.push(c); tableAtk = null;
            sortHand(ai); refill(); busy = false;
            if(checkEnd()) return;
            msgEl.innerHTML = t("durakAttack");
            render();
          }, 600);
        }
      } else {
        if(!tableAtk || !beats(c, tableAtk)) return;
        player.splice(idx, 1);
        tableAtk = null;
        swap(); refill();
        if(checkEnd()){ render(); return; }
        msgEl.innerHTML = t("durakAttack");
        render();
      }
    }

    function aiAttack(){
      if(!gameOn || ai.length === 0){ checkEnd(); return; }
      var sorted = ai.slice().sort(function(a,b){
        var at = (a.s===trumpSuit)?1:0, bt = (b.s===trumpSuit)?1:0;
        if(at !== bt) return at-bt;
        return val(a)-val(b);
      });
      var c = sorted[0];
      ai.splice(ai.indexOf(c), 1);
      tableAtk = c;
      msgEl.innerHTML = t("durakDefend");
      render();
    }

    function aiDefend(atk){
      var opts = ai.filter(function(c){ return beats(c, atk); }).sort(function(a,b){ return val(a)-val(b); });
      return opts.length ? opts[0] : null;
    }

    function swap(){ attacker = (attacker === "p") ? "a" : "p"; }
    function refill(){
      if(attacker === "p"){ drawUp(player); drawUp(ai); }
      else { drawUp(ai); drawUp(player); }
    }
    function drawUp(h){ while(h.length < 6 && deck.length) h.push(deck.pop()); sortHand(h); }

    function checkEnd(){
      if(deck.length > 0) return false;
      if(player.length === 0 || ai.length === 0){
        gameOn = false; tableAtk = null;
        render();
        if(player.length === 0 && ai.length === 0){
          setBalance(balance + bet);
          msgEl.innerHTML = t("durakDraw");
        } else if(player.length === 0){
          setBalance(balance + bet * 2);
          celebrate(true);
          msgEl.innerHTML = t("durakWin", {win: bet * 2});
        } else {
          msgEl.innerHTML = t("durakLose");
        }
        return true;
      }
      return false;
    }
  })();

  /* =========================================================
     POKER (heads-up Texas Hold'em vs AI)
