  function setupCustomBet(prefix, onApply){
    var input = document.getElementById(prefix + "BetInput");
    var applyBtn = document.getElementById(prefix + "BetApply");
    var maxBtn = document.getElementById(prefix + "BetMax");
    if(!input || !applyBtn) return;
    applyBtn.addEventListener("click", function(){
      var v = parseInt(input.value, 10);
      if(isNaN(v) || v < 1) v = 1;
      var cap = Math.max(1, Math.floor(balance));
      if(v > cap) v = cap;
      input.value = v;
      if(onApply) onApply(v);
    });
    if(maxBtn) maxBtn.addEventListener("click", function(){
      var v = Math.max(1, Math.floor(balance));
      input.value = v;
      if(onApply) onApply(v);
    });
  }

  function celebrate(big){
    var cv = document.createElement("canvas");
    cv.style.cssText = "position:fixed;inset:0;width:100vw;height:100vh;pointer-events:none;z-index:100";
    document.body.appendChild(cv);
    var ctx = cv.getContext("2d");
    cv.width = window.innerWidth; cv.height = window.innerHeight;
    var emo = ["🎉","💰","⭐","🎊","💎","🔥","🪙","✨","🤑","🏆"];
    var cols = ["#d4af37","#f2cf7e","#d9534a","#4c8c5c","#4b6fb0","#e8b93a","#2ea866"];
    var N = big ? 200 : 110;
    var ps = [];
    for(var i=0;i<N;i++){
      ps.push({
        x: Math.random()*cv.width, y: -30 - Math.random()*cv.height*0.6,
        vx: (Math.random()-0.5)*2.4, vy: 2.2 + Math.random()*4,
        s: 12 + Math.random()*18, r: Math.random()*Math.PI, vr: (Math.random()-0.5)*0.25,
        e: emo[i % emo.length], c: cols[i % cols.length], isEmoji: Math.random() < 0.45
      });
    }
    var start = Date.now();
    (function tick(){
      ctx.clearRect(0,0,cv.width,cv.height);
      var alive = false;
      ps.forEach(function(p){
        p.x += p.vx; p.y += p.vy; p.r += p.vr; p.vy += 0.02;
        if(p.y < cv.height + 50) alive = true;
        ctx.save(); ctx.translate(p.x, p.y); ctx.rotate(p.r);
        if(p.isEmoji){ ctx.font = p.s + "px serif"; ctx.textAlign = "center"; ctx.fillText(p.e, 0, 0); }
        else { ctx.fillStyle = p.c; ctx.fillRect(-p.s/2, -p.s/4, p.s, p.s/2); }
        ctx.restore();
      });
      if(alive && Date.now() - start < 4500) requestAnimationFrame(tick);
      else cv.remove();
    })();
  }

