    setupCustomBet("bj", function(v){ bet = v; document.getElementById("bjBetDisplay").textContent = v; });

    function freshDeck(){
      var d = [];
      suits.forEach(function(su){
        ranks.forEach(function(r){ d.push({r:r, s:su.s, c:su.c}); });
      });
      for(var i=d.length-1;i>0;i--){
        var j = Math.floor(Math.random()*(i+1));
        var tmp = d[i]; d[i]=d[j]; d[j]=tmp;
      }
